# Copy to `.env` for local development. Never commit the real `.env`.

# Required; no implicit development fallback. Allowed: development/test/staging/production.
ENVIRONMENT=development
# Optional explicit dotenv path for VM/systemd use. The process loads this file
# before validating settings; values are never printed. Leave unset for local
# services/backend/.env discovery.
HELLODOCTOR_ENV_FILE=
HOST=0.0.0.0
PORT=8080

# Explicit for local dev — the in-code fallback used when this is entirely
# unset is deliberately much quieter (info/warn), so a real deployment that
# forgets to set this gets safe behavior, not unconditional per-request
# debug logging. Set to a quieter value (e.g. `hellodoctor_backend=info,
# tower_http=warn,axum=warn`) in any real deployment.
RUST_LOG=hellodoctor_backend=debug,tower_http=debug,axum=info

# Allowed only in development/test; startup fails if true in staging/production.
# Set to true only when you explicitly want demo/fixture accounts inserted on startup.
# Leave unset/false for a real, empty database (production-like behavior).
SEED_DEV_DATA=false

# Postgres connection (see docker-compose.yml for the local dev container).
# Superuser — used only to run migrations at startup.
DATABASE_URL=postgres://hellodoctor:hellodoctor_dev_password@localhost:5432/hellodoctor

# Five least-privilege capability roles (see migrations/20261003000001_rls_hardening)
# replace the single generic app role. The roles themselves are created NOLOGIN
# by the migration — no password ever lives in committed SQL. On every startup
# the app bootstraps LOGIN + password for each role from the five secrets below
# via `ALTER ROLE ... WITH LOGIN PASSWORD`, run through the superuser connection.
# Generate each with: openssl rand -hex 24 (hex-only — required, see main.rs).
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=hellodoctor
DB_API_ROLE_PASSWORD=
DB_AUTH_WORKER_PASSWORD=
DB_PAYMENT_WORKER_PASSWORD=
DB_SYSTEM_WORKER_PASSWORD=
DB_FINANCE_WORKER_PASSWORD=
DB_POOL_MAX_CONNECTIONS_PER_ROLE=10

# Controlled admission cap on new user activation (patient self-registration,
# admin-created doctor accounts) — never affects existing users/sessions.
# Raise only after an evidence-gated capacity review (see docs/CHECKPOINT.md).
#
# Raised 2026-10-31 (Milestone 8, docs/MILESTONE_8_SUSTAINED_RELIABILITY.md
# §10 and docs/MILESTONE_8_FUNCTIONAL_DEPENDENCY_VERIFICATION.md): the
# approved scalability objective is 10,000 registered accounts / 2,000
# concurrently active, verified clean for a full 40-minute sustained run at
# that active-session count (zero defects, zero OOM, Postgres memory
# plateaus rather than growing unbounded). This counter counts EVERY active
# user regardless of role (patients + doctors + admins combined, see
# user_repo::count_active), so 10,000 alone would leave zero room for
# doctor/admin accounts or organic growth before silently blocking
# registration again (exactly what happened mid-Milestone-8 at the old 1200
# default, once the test dataset itself reached ~10,050 users). Set to
# 15,000: the approved 10,000-patient target plus ~50% headroom for
# doctors/admins and growth, still a deliberately bounded pilot ceiling, not
# "unlimited" — raise again only via the same evidence-gated review.
MAX_ACTIVE_USERS=15000

# Global per-IP request ceiling (docs/AUTH_SECURITY.md §9). Only raise this
# for local load-testing (examples/load_test.rs sends every simulated user's
# traffic from the one real IP of the machine running it, unlike real
# distributed production traffic) — leave at 120 in any real deployment.
GLOBAL_IP_RATE_LIMIT_PER_MIN=120

# Redis connection, used for rate limiting and the IP-jail (see docker-compose.yml).
REDIS_URL=redis://localhost:6379

# Ed25519 keypair for JWT signing, PKCS8/SPKI DER, base64-encoded.
# Generate with:
#   openssl genpkey -algorithm ed25519 -outform DER -out jwt_private.der
#   openssl pkey -in jwt_private.der -inform DER -pubout -outform DER -out jwt_public.der
#   base64 -w0 jwt_private.der ; base64 -w0 jwt_public.der
JWT_ED25519_PRIVATE_KEY_B64=
JWT_ED25519_PUBLIC_KEY_B64=

# 32-byte key (base64) used to encrypt TOTP secrets at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY_B64=

# Agora RTC credentials — server-side only, never shipped to the Flutter client.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# How long before/after a slot's scheduled window an RTC token may still be
# minted (docs/AUTH_SECURITY.md §10.2). A product decision, not a constant —
# override here if the real policy differs from these defaults.
AGORA_TOKEN_WINDOW_BEFORE_MINS=15
AGORA_TOKEN_WINDOW_AFTER_MINS=60

# HMAC-SHA256 secret used to verify payment gateway webhook signatures.
# Generate with: openssl rand -hex 32
WEBHOOK_HMAC_SECRET=

# Agora Console Notification Service signing secret for provider-confirmed
# RTC callbacks. The endpoint also requires Agora-Signature-V2 over the exact
# raw body; a locally invented secret or client callback is not accepted.
# Leave empty only until the real provider callback integration is configured;
# the endpoint fails closed while it is empty.
AGORA_WEBHOOK_HMAC_SECRET=

# FCM HTTP v1 service-account settings. Server-only; never place these in
# Flutter assets, API responses or logs. FCM_PRIVATE_KEY_B64 is the base64
# encoding of the PEM private key from the service-account secret manager.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY_B64=

# Shared only by the Admin BFF and Rust API. Required before deployed API startup.
# At least 32 non-whitespace characters; independent of other proxy/JWT secrets.
# Generate and inject through approved server secret management.
WEB_AUTH_ASSERTION_SECRET=

STORAGE_BUCKET=helodoc-medical-records
# Azure is the approved production provider. Provider selection is explicit;
# Azure never falls back to legacy S3 when its configuration is invalid.
STORAGE_PROVIDER=disabled
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_AUTH_MODE=managed_identity
AZURE_STORAGE_CLINICAL_CONTAINER=
AZURE_STORAGE_ARTICLE_CONTAINER=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CLIENT_ID=
AZURE_STORAGE_ENDPOINT=
AZURE_STORAGE_USE_EMULATOR=false
# AZURE_STORAGE_AUTH_MODE=account_key is rejected in staging/production unless
# this is explicitly set to true. Defaults to false (rejected). See
# docs/AZURE_BLOB_SETUP.md "Account-key mode" before enabling it.
AZURE_STORAGE_ACCOUNT_KEY_RISK_ACKNOWLEDGED=false
# Legacy S3-compatible settings are retained only for explicit compatibility
# fixtures (`STORAGE_PROVIDER=legacy_s3`), never selected automatically.
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENCRYPTION_KEY_B64=

# Comma-separated list of allowed CORS origins for the admin/web clients.
ALLOWED_ORIGINS=http://localhost:3000

# Development-only authentication and simulation must be explicitly enabled.
# Production/staging refuse development OTP; production refuses simulations.
DEV_AUTH_OTP_ENABLED=false

# Phase 2: Secure Email OTP Password Recovery (Patient/Doctor self-service;
# Admin excluded) is implemented — see services/password_reset_service.rs
# and tests/cases/password_reset.rs. May be set true in development/test
# only (requires DEV_AUTH_OTP_ENABLED=true or real email configuration);
# startup unconditionally rejects true in staging/production pending a real
# Azure Communication Services delivery acceptance test. Existing
# login/logout and authenticated password-change behavior are unaffected
# either way.
PASSWORD_RESET_ENABLED=false
RECOVERY_MODE=false
RECOVERY_OPERATOR_TOKEN_SHA256=

# Azure Communication Services Email (required outside development/test —
# Patient, Doctor and Admin login all depend on it to complete MFA)
AZURE_EMAIL_ENDPOINT=https://<resource>.communication.azure.com
AZURE_EMAIL_ACCESS_KEY=<base64-access-key>
AZURE_EMAIL_SENDER=DoNotReply@<verified-domain>
# access_key (default; only implemented mode) or managed_identity (recognized
# but rejected at startup — its REST auth contract for the Email data-plane
# endpoint could not be verified against official Microsoft documentation).
AZURE_EMAIL_AUTH_MODE=access_key
DEV_SIMULATION_ENABLED=false
# Staging/production require a TLS ingress/BFF with exact trusted socket IPs,
# HTTPS PUBLIC_API_BASE_URL/ALLOWED_ORIGINS, and a 32+ character monitoring token.
# A trusted ingress MUST overwrite X-Forwarded-Proto and single-IP X-Forwarded-For.
TRUSTED_PROXY_IPS=
METRICS_SCRAPE_TOKEN=

# Local (Africa/Nairobi, fixed UTC+3, no DST) time-of-day at which the
# background notification scheduler sends each verified Doctor their
# DAILY_CONSULTATION_SUMMARY notification for that calendar day (HH:MM,
# 24-hour). See services/notification_scheduler.rs.
DOCTOR_DAILY_SUMMARY_TIME_LOCAL=07:00
ENGAGEMENT_GREETING_TIME_LOCAL=08:00

# Temporary consultation trace only; clinical/business/audit records are unaffected.
# Accepted values: 3, 4 or 5 days. Grievance holds override cleanup.
CONSULTATION_TRACE_RETENTION_DAYS=5
