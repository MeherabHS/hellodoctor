# Disposable local HTTPS endpoint for the two-phone physical Agora test.
#
# `tls internal`'s automatic certificate matching depends on SNI, but a TLS
# client connecting to a literal IP address (RFC 6066: SNI cannot carry an IP
# literal) always sends an empty ServerName - confirmed live: Caddy then
# tries to match a cert by the connection's LOCAL socket address, which
# inside this container is its own Docker-bridge IP (e.g. 172.21.0.x), never
# the host's LAN IP the cert was actually issued for, so the handshake fails
# with "no certificate available" regardless of host config. A statically
# loaded cert (self-signed, IP SAN 192.168.0.103, generated by
# scripts/generate_phonetest_tls.sh) sidesteps this entirely: with exactly
# one cert loaded for this one site, there is nothing to match against SNI.
#
# This self-signed cert is not publicly trusted, so each test phone needs it
# installed as a user CA once (see PHONE_TEST_HANDOFF) - the apps'
# `fieldtest` build type (never the real `release` build type) narrowly
# trusts user-installed CAs for exactly this one IP, nothing else.
{
    admin off
    debug
    # Caddy's cert selection needs an identifier to match against; with no
    # SNI (the normal case for a client connecting to a bare IP) it
    # otherwise falls back to the connection's LOCAL socket address, which
    # inside this container is its own Docker-bridge IP, not the host's LAN
    # IP - this tells it to treat an absent SNI as this specific host
    # instead, which is the officially supported fix for serving TLS to
    # IP-literal clients. Top-level global option, not nested under `servers`.
    default_sni 192.168.0.103
}

192.168.0.103:8443 {
    tls /certs/phonetest.crt /certs/phonetest.key
    reverse_proxy backend:8080
}
