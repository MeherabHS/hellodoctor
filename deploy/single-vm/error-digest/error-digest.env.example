# Copy to /etc/hellodoctor/error-digest.env (chmod 600). Never commit the
# real file. The SMTP password lives in its own file, not here.

# Where the report goes (comma-separated for more than one address).
DIGEST_TO=you@example.com

# Any SMTP mailbox. Gmail: smtp.gmail.com, port 587, your address as the
# user and a Google "App password" (not your normal password) in the file.
DIGEST_SMTP_HOST=smtp.gmail.com
DIGEST_SMTP_PORT=587
DIGEST_SMTP_USER=alerts@example.com
DIGEST_SMTP_PASSWORD_FILE=/etc/hellodoctor/error-digest-smtp-password
DIGEST_FROM=alerts@example.com

# Must match deploy/single-vm/compose.yml (project "hellodoctor-vm").
DIGEST_COMPOSE_PROJECT=hellodoctor-vm
DIGEST_PG_CONTAINER=hellodoctor-vm-postgres-1
DIGEST_PG_USER=hellodoctor
DIGEST_PG_DB=hellodoctor

# Optional
DIGEST_WINDOW_HOURS=24
DIGEST_DISK_WARN_PERCENT=80
