{
    admin off
    auto_https off
}

http://api.localhost {
    # Phase 7 diagnostic logging (2026-11-03): temporary, isolated-verification
    # only. Caddy's default JSON access log format logs method/uri/status/size/
    # duration -- it does NOT log header values (so Authorization/Bearer tokens
    # are never written), request bodies, or query strings beyond the path.
    # No PHI/payment credentials/chat content are logged. Reversible -- see
    # Caddyfile.local-verification.orig-backup for the pre-diagnostic config.
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>headers>Authorization delete
                request>headers>Cookie delete
            }
        }
    }
    reverse_proxy backend:8080
}

http://admin.localhost {
    reverse_proxy admin-web:3000
}

http://doctor.localhost {
    reverse_proxy doctor-web:3000
}

http://:8081 {
    respond /healthz 200
}
