# Ubuntu Server 24.04 LTS / Standard_D4pls_v6 / linux-arm64 deployment.
# This file contains image references only; secrets belong in the private
# /etc/hellodoctor/hellodoctor.env file and must not be committed.
#
# The official base-image references below are OCI manifest-list digests
# inspected with `docker buildx imagetools inspect` on 2026-11-05. Buildx
# resolves their native linux/arm64 child on the target VM.
POSTGRES_IMAGE=postgres:16-bookworm@sha256:e8a07d2c7579b038938cdba6c539e580e5001caf9ea203d397b5cc83e76bd938
REDIS_IMAGE=redis:7-alpine@sha256:8da19c7399dca900c6822a1cf30f9d2285585e2c4b457ff4095b0f4500054d3f
CADDY_IMAGE=caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5

# Replace these with the reviewed ARM64 application artifacts produced by the
# release pipeline. They must be digest-pinned linux/arm64 images (or a
# reviewed multi-platform manifest digest), never mutable architecture tags.
BACKEND_RUNTIME_IMAGE=registry.example.invalid/hellodoctor/backend@sha256:REPLACE_WITH_REVIEWED_ARM64_DIGEST
ADMIN_WEB_IMAGE=registry.example.invalid/hellodoctor/admin-web@sha256:REPLACE_WITH_REVIEWED_ARM64_DIGEST
DOCTOR_WEB_IMAGE=registry.example.invalid/hellodoctor/doctor-web@sha256:REPLACE_WITH_REVIEWED_ARM64_DIGEST
POSTGRES_BACKUP_IMAGE=registry.example.invalid/hellodoctor/postgres-pgbackrest@sha256:REPLACE_WITH_REVIEWED_ARM64_DIGEST
