# HelloDoctor.Asia unified operator configuration template.
# Copy to /etc/hellodoctor/hellodoctor.env on a VM and protect it (root:root,
# mode 0600). Never commit a real copy. Restart the affected server after
# changing a runtime value; rebuild browser/mobile artifacts for build-time
# values marked below.

# -----------------------------------------------------------------------------
# General environment (backend + web runtime)
# -----------------------------------------------------------------------------
ENVIRONMENT=development                 # required: development|test|staging|production
HELLODOCTOR_ENV_FILE=                   # optional backend dotenv path; restart
HOST=0.0.0.0                            # backend bind host; restart
PORT=8080                               # backend listen port; restart
RUST_LOG=hellodoctor_backend=info,tower_http=warn,axum=warn
SEED_DEV_DATA=false                     # development/test only; restart

# -----------------------------------------------------------------------------
# Domains, ingress and service ports
# -----------------------------------------------------------------------------
PUBLIC_API_BASE_URL=http://127.0.0.1:8080 # backend public URL; HTTPS outside dev; restart
ALLOWED_ORIGINS=http://localhost:3000      # comma-separated browser origins; restart
TRUSTED_PROXY_IPS=                         # exact TLS proxy IPs; required staging/production
ADMIN_WEB_ORIGIN=http://127.0.0.1:3000    # Admin BFF origin; restart
DOCTOR_WEB_ORIGIN=http://127.0.0.1:3001   # Doctor BFF origin; restart
BACKEND_URL=http://127.0.0.1:8080         # server-side web-to-backend URL; restart
ADMIN_WEB_BUILD_NUMBER=unreported         # web diagnostics label; restart
DOCTOR_WEB_BUILD_NUMBER=unreported        # web diagnostics label; restart
# Web listen ports are currently supplied by `next start -p` (3000/3001), not
# read as environment variables. Put the reverse-proxy listener in front.

# -----------------------------------------------------------------------------
# PostgreSQL and capability-separated roles (server-only secrets)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://hellodoctor:REPLACE@127.0.0.1:5432/hellodoctor # migration superuser DSN; restart
APP_DB_HOST=127.0.0.1                    # capability-pool host; restart
APP_DB_PORT=5432                          # capability-pool port; restart
APP_DB_NAME=hellodoctor                   # capability-pool database; restart
DB_API_ROLE_PASSWORD=REPLACE_HEX_48       # server secret; restart
DB_AUTH_WORKER_PASSWORD=REPLACE_HEX_48    # server secret; restart
DB_PAYMENT_WORKER_PASSWORD=REPLACE_HEX_48 # server secret; restart
DB_SYSTEM_WORKER_PASSWORD=REPLACE_HEX_48  # server secret; restart
DB_FINANCE_WORKER_PASSWORD=REPLACE_HEX_48  # server secret; restart
DB_POOL_MAX_CONNECTIONS_PER_ROLE=10       # restart

# -----------------------------------------------------------------------------
# Redis (server-only; also used by web refresh coordination)
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379           # backend + server-side web runtime; restart

# -----------------------------------------------------------------------------
# Authentication, JWT, Admin HMAC and Turnstile (server-only)
# -----------------------------------------------------------------------------
JWT_ED25519_PRIVATE_KEY_B64=REPLACE_BASE64_DER # backend secret; restart
JWT_ED25519_PUBLIC_KEY_B64=REPLACE_BASE64_DER  # backend verification key; restart
TOTP_ENCRYPTION_KEY_B64=REPLACE_BASE64_32       # backend secret; restart
WEB_AUTH_ASSERTION_SECRET=REPLACE_32_CHARS      # Admin BFF ↔ backend; restart
WEB_PROXY_SECRET=REPLACE_32_CHARS              # ingress assertion; restart
TURNSTILE_SITE_KEY=                             # public widget value; web restart/rebuild as applicable
TURNSTILE_SECRET_KEY=REPLACE_SECRET             # server-only; web restart
DEV_AUTH_OTP_ENABLED=false                      # development/test only; restart/rebuild Flutter
DEV_SIMULATION_ENABLED=false                    # development/test/staging only; restart
PASSWORD_RESET_ENABLED=false                    # development/test only (see note below); restart
RECOVERY_MODE=false                              # restored read-mostly mode; restart
RECOVERY_OPERATOR_TOKEN_SHA256=                 # 64-hex digest, required only in recovery mode

# Phase 2: Secure Email OTP Password Recovery (Patient/Doctor self-service;
# Admin is explicitly excluded — see services/password_reset_service.rs) is
# implemented and covered by tests/cases/password_reset.rs. This flag may be
# set true in `development`/`test` only (requires DEV_AUTH_OTP_ENABLED=true,
# or real Azure email configuration, exactly like login OTP) — in
# `staging`/`production` it fails closed unconditionally at startup: this
# codebase has never completed a real Azure Communication Services delivery
# acceptance test, so enabling self-service account recovery against real
# accounts ahead of that verification is a deliberately separate decision.

# -----------------------------------------------------------------------------
# Password recovery email / OTP (Azure Communication Services; server-only)
# -----------------------------------------------------------------------------
AZURE_EMAIL_ENDPOINT=https://RESOURCE.communication.azure.com # required outside dev/test; restart
AZURE_EMAIL_ACCESS_KEY=REPLACE_BASE64_KEY                      # required outside dev/test; restart
AZURE_EMAIL_SENDER=DoNotReply@example.invalid                  # verified sender; restart
AZURE_EMAIL_AUTH_MODE=access_key # access_key (only implemented mode) or managed_identity (rejected at startup; not yet verified)

# -----------------------------------------------------------------------------
# Agora (server-only; never place these in Flutter)
# -----------------------------------------------------------------------------
AGORA_APP_ID=REPLACE_APP_ID                 # restart
AGORA_APP_CERTIFICATE=REPLACE_CERTIFICATE   # restart
AGORA_TOKEN_WINDOW_BEFORE_MINS=15           # restart
AGORA_TOKEN_WINDOW_AFTER_MINS=60            # restart
AGORA_WEBHOOK_HMAC_SECRET=                  # optional until provider callback is configured; restart

# -----------------------------------------------------------------------------
# Firebase FCM HTTP v1 (server-only)
# -----------------------------------------------------------------------------
FCM_PROJECT_ID=                              # required outside development/test; restart
FCM_CLIENT_EMAIL=                             # required outside development/test; restart
FCM_PRIVATE_KEY_B64=                         # base64 service-account PEM; restart

# -----------------------------------------------------------------------------
# Storage and application encryption
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=disabled                    # disabled|azure|legacy_s3; restart
STORAGE_BUCKET=helodoc-medical-records       # legacy metadata/default; restart
STORAGE_ENCRYPTION_KEY_B64=                  # existing AES-256-GCM object key; restart
# Azure Blob (production target; both containers remain private)
AZURE_STORAGE_ACCOUNT_NAME=                 # lowercase account name; restart
AZURE_STORAGE_AUTH_MODE=managed_identity    # managed_identity|account_key|azurite
AZURE_STORAGE_CLINICAL_CONTAINER=           # private clinical container; restart
AZURE_STORAGE_ARTICLE_CONTAINER=            # distinct private article-media container; restart
AZURE_STORAGE_ACCOUNT_KEY=                  # only for account_key mode; never expose
AZURE_STORAGE_CLIENT_ID=                    # optional user-assigned managed identity; restart
AZURE_STORAGE_ENDPOINT=                    # optional HTTPS account origin; restart
AZURE_STORAGE_USE_EMULATOR=false            # azurite only in development/test; restart
AZURE_STORAGE_ACCOUNT_KEY_RISK_ACKNOWLEDGED=false  # required true for account_key outside dev/test
# object_store's Azurite endpoint override (test process/container only)
# AZURITE_BLOB_STORAGE_URL=http://127.0.0.1:10000
# Legacy S3-compatible mode is retained only for explicit compatibility tests;
# it is never selected automatically when STORAGE_PROVIDER=azure.
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Notification scheduler and admission controls
# -----------------------------------------------------------------------------
PAYMENT_RESERVATION_WINDOW_SECS=600          # restart
MAX_ACTIVE_USERS=1200                        # restart
GLOBAL_IP_RATE_LIMIT_PER_MIN=120             # restart
DOCTOR_DAILY_SUMMARY_TIME_LOCAL=07:00       # Africa/Nairobi HH:MM; restart
ENGAGEMENT_GREETING_TIME_LOCAL=08:00        # Africa/Nairobi HH:MM; restart
CONSULTATION_TRACE_RETENTION_DAYS=5         # 3..5; restart

# -----------------------------------------------------------------------------
# Payment-provider switches
# -----------------------------------------------------------------------------
# No live payment-provider credential or enablement variable is currently read
# by the backend. Provider execution remains intentionally deferred. Existing
# payment reservation and DEV_SIMULATION_ENABLED controls above are the only
# runtime settings in this repository.

# -----------------------------------------------------------------------------
# Logging, monitoring and backup operations
# -----------------------------------------------------------------------------
METRICS_SCRAPE_TOKEN=REPLACE_32_CHARS        # required staging/production; restart
# Backup destination/retention is an operator/database policy, not an app env
# variable today. Configure it outside the containers and never place dumps in
# the application build context.

# -----------------------------------------------------------------------------
# Flutter build-time configuration (not server secrets)
# -----------------------------------------------------------------------------
# Pass with --dart-define and rebuild each mobile artifact when changed.
API_BASE_URL=https://api.example.invalid/api/v1
APP_BUILD=unreported
FLUTTER_BUILD_NAME=1.0.0
FLUTTER_BUILD_NUMBER=1
ALLOW_INSECURE_HTTP=false                  # development LAN only; rebuild
DEV_PAYOUT_BINDING=false                    # Doctor development only; rebuild
