+    let final_page = get(&app, &path, Some(&patient)).await;
+    assert_eq!(final_page.status(), StatusCode::OK);
+    assert_eq!(
+        json_body(final_page).await["data"]
+            .as_array()
+            .unwrap()
+            .len(),
+        0
+    );
+}
