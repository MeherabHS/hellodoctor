# Rust build artifacts
target/
**/*.rs.bk
# services/backend/Cargo.lock is intentionally tracked (application binary,
# not a library — fixes h18-cargo-audit-unaudited-drift). If another Rust
# crate is ever added to this repo that IS a library, ignore its lockfile
# specifically rather than repo-wide.

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo

# OS files
Thumbs.db
[Dd]esktop.ini
.DS_Store

# Logs & temp
*.log
tmp/

# Node & Next.js
node_modules/
.next/
out/
.env*.local
*.tsbuildinfo

# Local credentials and exported bearer-token artifacts must never be committed.
**/.env
**/.env.*
!**/.env.example
!**/.env.local.example
*_token.txt
*_tokens.json
*.jwt

# Local signing/credential files are never deployment build inputs.
*.pem
*.key
*.der

# Tool-internal agent metadata and local Claude Code config — never product
# code, never meant to be shared across clones.
.agents/
.claude/
skills-lock.json

# Ad-hoc session scratch work (debug scripts, logs, full-repo backups made
# during a remediation pass). Never a source of truth; use a real scratchpad
# directory outside the repo for future sessions instead of writing here.
scratch/
grievances_out.json

# Built APK artifacts bloat the repo as binaries; keep release *docs* (e.g.
# releases/*.md test-session notes) tracked, but never the signed binaries
# themselves.
releases/*.apk
