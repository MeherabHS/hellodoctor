# Rust build artifacts
target/
**/*.rs.bk
Cargo.lock

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo

# OS files
Thumbs.db
[Dd]esktop.ini
.DS_Store

# Logs & temp
*.log
tmp/

# Node & Next.js
node_modules/
.next/
out/
.env*.local
*.tsbuildinfo

# Local credentials and exported bearer-token artifacts must never be committed.
**/.env
**/.env.*
!**/.env.example
!**/.env.local.example
*_token.txt
*_tokens.json
*.jwt

# Local signing/credential files are never deployment build inputs.
*.pem
*.key
*.der
