<?xml version="1.0" encoding="utf-8"?>
<!-- Azure App Service (Windows/IIS) equivalent of staticwebapp.config.json:
     clean URLs, security headers, and nothing but the public pages served. -->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Content-Security-Policy" value="default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests" />
        <add name="Strict-Transport-Security" value="max-age=63072000; includeSubDomains" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="accelerometer=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=(), xr-spatial-tracking=()" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
        <add name="Cross-Origin-Resource-Policy" value="same-origin" />
        <add name="X-Permitted-Cross-Domain-Policies" value="none" />
        <add name="X-DNS-Prefetch-Control" value="off" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering removeServerHeader="true" allowDoubleEscaping="false">
        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true" />
          <add verb="HEAD" allowed="true" />
        </verbs>
        <hiddenSegments>
          <add segment="scratch" />
          <add segment="previews" />
          <add segment=".git" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".py" allowed="false" />
          <add fileExtension=".json" allowed="false" />
          <add fileExtension=".config" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="Hide drafts" stopProcessing="true">
          <match url="^(concept-.*|sauti-v[23].*|styles\.css)$" />
          <action type="CustomResponse" statusCode="404" />
        </rule>
        <rule name="consent to patient-consent" stopProcessing="true">
          <match url="^consent(\.html)?$" />
          <action type="Redirect" url="/patient-consent" redirectType="Permanent" />
        </rule>
        <rule name="index.html to root" stopProcessing="true">
          <match url="^index\.html$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="Drop .html" stopProcessing="true">
          <match url="^(.+)\.html$" />
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Serve page.html for /page" stopProcessing="true">
          <match url="^([^.]+?)/?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".txt" />
      <mimeMap fileExtension=".txt" mimeType="text/plain; charset=utf-8" />
    </staticContent>
  </system.webServer>
</configuration>
