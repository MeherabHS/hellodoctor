**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Firebase native configuration is a per-deployment secret (real project
# credentials), supplied only through the deployment secret process — never
# committed. See docs/FCM_SETUP.md.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart

# Internal-testing release-signing keystore and its credentials — a
# per-deployment secret (never a production/Play Store key), supplied only
# through the deployment secret process, never committed. See
# android/app/build.gradle.kts's internalTestKeystoreProperties block.
android/app/internal-test-keystore.properties
android/app/*.jks
android/app/*.keystore
