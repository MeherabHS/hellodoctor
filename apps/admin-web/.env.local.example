# Copy to .env.local for local development. Never commit the real .env.local.

# Server-side only (deliberately NOT prefixed NEXT_PUBLIC_ — the browser must
# never talk to the Rust backend directly; every request goes through this
# Next.js server's own /api/* route handlers, which attach the admin's
# session from an HttpOnly cookie before forwarding).
BACKEND_URL=http://localhost:8080

# Explicit synthetic-data local development. Never expose this to the internet.
ENVIRONMENT=development
DEV_AUTH_OTP_ENABLED=true
ADMIN_WEB_ORIGIN=http://127.0.0.1:3000
# Staging/production require an HTTPS origin and an independently generated,
# server-only ingress credential (32+ characters). TLS proxy must overwrite
# X-HelloDoctor-Proxy, X-Forwarded-Proto, and a single-client-IP X-Forwarded-For.
WEB_PROXY_SECRET=

# Required for staging/production browser login; server reads these at runtime.
# Site key is public widget configuration. Secret must NEVER use NEXT_PUBLIC_.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Independent server-only shared secret with Rust API (32+ nonspace characters).
# Binds Admin login requests to successful BFF challenge verification; rotate together.
WEB_AUTH_ASSERTION_SECRET=
# Configure widget hostname to ADMIN_WEB_ORIGIN's hostname; action=admin_login.
# Explicit development/test ENVIRONMENT bypasses challenge; no production bypass.
